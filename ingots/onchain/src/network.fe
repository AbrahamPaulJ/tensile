//! `Network`: the whole forward pass in one call.
use ingot::rows::{ROWS_PER_CONTRACT, RowMsg}
use model::{Input, Logits, layer1, layer2}
use std::evm::{Address, Call}
use tensile::{Activations, Row}

/// The output of layer 1.
type Hidden = Activations<32, 3>

/// Runs the network on an input given as packed words (`docs/spec.md`
/// section 7). A malformed input reverts.
pub msg NetworkMsg {
    /// The predicted class, 0..9.
    #[selector = sol("classify(uint256[25])")]
    Classify { x: [u256; 25] } -> u256,
    /// The 32 hidden activations as one packed word, and the 10 logits.
    #[selector = sol("trace(uint256[25])")]
    Trace { x: [u256; 25] } -> ([u256; 1], [i32; 10]),
}

/// The network 784 -> 32 -> 10 on the EVM. The weights of layer 1 do not fit
/// one contract, so every row is read from one of two weight contracts
/// (`RowsLow`, `RowsHigh`); layer 2 is in this contract's code.
pub contract Network uses (call: Call) {
    low: Address,
    high: Address,

    init(low_rows: Address, high_rows: Address)
    uses (mut low, mut high)
    {
        low = low_rows
        high = high_rows
    }

    recv NetworkMsg {
        Classify { x } -> u256 uses (call, low, high) {
            let hidden = hidden_layer(x: Activations::from_words(x), low, high)
            layer2::apply(x: hidden).argmax() as u256
        }

        Trace { x } -> ([u256; 1], [i32; 10]) uses (call, low, high) {
            let hidden = hidden_layer(x: Activations::from_words(x), low, high)
            (hidden.words(), layer2::apply(x: hidden).values())
        }
    }
}

/// Layer 1, one neuron at a time: `layer1::neuron` on a row fetched from the
/// weight contract that holds it.
fn hidden_layer(x: Input, low: Address, high: Address) -> Hidden
uses (call: Call)
{
    var values: [i8; 32] = [0; 32]
    for j in 0 .. 32 {
        let holder = if j < ROWS_PER_CONTRACT { low } else { high }
        let row = Row::from_words(holder.static(RowMsg::Row { j }))
        values[j] = layer1::neuron(row, x, bias: layer1::bias(j))
    }
    Activations::pack(values)
}
