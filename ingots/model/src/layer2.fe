}

/// Output `j` of this layer alone, the logit of one neuron, from row `j` of the weights and
/// bias `j`. It is `tensile::neuron`, the function `apply` runs once per row.
pub fn neuron(row: Row<32, 6>, x: Activations<32, 3>, bias: Q<9>) -> i32 {
