/// The biases, at the scale of a weight times an input.
pub const BIAS: Bias<32, 14> = Bias::from_raw(
    [
        2030,
        6195,
        5106,
        5458,
        6364,
        5779,
        -567,
        355,
        1946,
        4030,
        -537,
        2756,
        3750,
        10954,
        6682,
        7181,
        182,
        8490,
        367,
        6965,
        6585,
        4947,
        3759,
        225,
        2044,
        5163,
        -3008,
        6508,
        -1259,
        1852,
        3677,
        2196,
    ],
)

/// The largest absolute accumulator over every input in 0..127, as recorded in the model
/// file.
pub const WORST_CASE: u256 = 1481397

// The overflow proof: the compiler recomputes the bound from the weights and biases above,
// requires the recorded value, and requires that it fits an int32.
static_assert(worst_case(weights: WEIGHTS, bias: BIAS) == WORST_CASE)
static_assert(WORST_CASE <= I32_MAX)

/// Layer 1: accumulators with 14 fractional bits, requantised by 11 bits and clamped
/// to 0..127.
pub fn apply(x: Activations<784, 7>) -> Activations<32, 3> {
    dense(weights: WEIGHTS, x: x, bias: BIAS).requantise<11>()
}

/// Output `j` of this layer alone, the activation of one neuron, from row `j` of the weights and
/// bias `j`. It is `tensile::neuron`, the function `apply` runs once per row.
pub fn neuron(row: Row<784, 7>, x: Activations<784, 7>, bias: Q<14>) -> i8 {
    tensile::neuron(row, x, bias).shifted<11>().clamped()
}

/// `neuron` on packed words, the form a contract receives (`docs/spec.md` section 7). Fails
/// if the row or the input is malformed: a padding byte that is not zero, or an input
/// outside 0..127.
pub fn neuron_from_words(row: [u256; 25], x: [u256; 25], bias: i32) -> i8 {
    neuron(
        row: Row::from_words(row),
        x: Activations::from_words(x),
        bias: Q::from_raw(bias),
    )
}

/// Row `j` of the weights.
pub const fn row(_ j: usize) -> Row<784, 7> {
    WEIGHTS.row(j)
}

/// Bias `j`.
pub const fn bias(_ j: usize) -> Q<14> {
    BIAS.at(j)
}
