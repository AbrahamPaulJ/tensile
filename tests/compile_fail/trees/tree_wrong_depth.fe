// expect: type mismatch
// expect: expected `Tree<2, 4, 8>`, but `Tree<3, 4, 8>` is given
// A forest of depth-2 trees cannot take a tree of depth 3.
use trees::{Base, Forest, Tree}

pub fn forest(a: Tree<2, 4, 8>, b: Tree<3, 4, 8>) -> Forest<2, 2, 4, 2, 8> {
    Forest::new([a, b], base: Base::from_raw([0, 0]))
}
