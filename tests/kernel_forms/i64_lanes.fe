//! Kernel form `i64-lanes`: the milestone 1 form, shaped for native speed.
//! Each word is read as four 64-bit limbs, and a lane is sign-extended by
//! shifting it to the top of the limb and back down.
use ingot::dense::dot_fits_i32
use ingot::packed::{Packed, word_count}

/// Dot product of `N` int8 weights and `N` activations.
///
/// The arithmetic is unchecked, and the `where` clause is the proof that it
/// cannot overflow.
#[arithmetic(unchecked)]
pub(ingot) fn dot<const N: usize>(weights: Packed<N>, activations: Packed<N>) -> i32
where dot_fits_i32(N)
{
    var sum: i64 = 0
    for k in 0 .. word_count(N) {
        let u = weights.words[k]
        let v = activations.words[k]
        sum += dot8(
            (u >> 192).downcast_truncate(),
            (v >> 192).downcast_truncate(),
        )
        sum += dot8(
            (u >> 128).downcast_truncate(),
            (v >> 128).downcast_truncate(),
        )
        sum += dot8(
            (u >> 64).downcast_truncate(),
            (v >> 64).downcast_truncate(),
        )
        sum += dot8(u.downcast_truncate(), v.downcast_truncate())
    }
    sum.downcast_truncate()
}

/// Dot product of the eight int8 values in each of two limbs.
#[arithmetic(unchecked)]
fn dot8(_ a: i64, _ b: i64) -> i64 {
    lane(a, b, 0)
        + lane(a, b, 8)
        + lane(a, b, 16)
        + lane(a, b, 24)
        + lane(a, b, 32)
        + lane(a, b, 40)
        + lane(a, b, 48)
        + lane(a, b, 56)
}

/// Product of the int8 values that lie `skip` bits below the top of two
/// limbs.
#[arithmetic(unchecked)]
fn lane(_ a: i64, _ b: i64, _ skip: i64) -> i64 {
    ((a << skip) >> 56) * ((b << skip) >> 56)
}

#[test]
fn dot_reaches_both_extremes_without_overflow() {
    let low = Packed<64>::pack([-128; 64])
    let high = Packed<64>::pack([127; 64])
    assert!(dot(weights: high, activations: high) == 64 * 127 * 127)
    assert!(dot(weights: low, activations: high) == -64 * 128 * 127)
}
