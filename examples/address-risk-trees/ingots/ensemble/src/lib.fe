    recv SliceMsg0 {
        Outputs { x } -> [u256; 4] {
            let input = Input::from_words(x)
            let slice = SLICE_0
            var values: [i32; 64] = [0; 64]
            for t in 0 .. 64 {
                values[t] = slice[t].eval(input).raw()
            }
            Slice<64, 14>::pack(values).words()
        }
    }
}

