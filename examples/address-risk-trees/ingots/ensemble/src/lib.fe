/// Runs the forest on an input given as packed words. A malformed input
/// reverts.
pub msg EnsembleMsg {
    /// The predicted class.
    #[selector = sol("classify(uint256[1])")]
    Classify { x: [u256; 1] } -> u256,
    /// The output of every tree as packed words, and the class scores.
    #[selector = sol("trace(uint256[1])")]
    Trace { x: [u256; 1] } -> ([u256; 19], [i32; 2]),
}

/// The forest on the EVM.
pub contract Ensemble uses (call: Call) {
    holder0: Address,
    holder1: Address,
    holder2: Address,
    holder3: Address,
    holder4: Address,

    init(
        address0: Address,
        address1: Address,
        address2: Address,
        address3: Address,
        address4: Address,
    )
    uses (mut holder0, mut holder1, mut holder2, mut holder3, mut holder4)
    {
        holder0 = address0
        holder1 = address1
        holder2 = address2
        holder3 = address3
        holder4 = address4
    }

    recv EnsembleMsg {
        Classify { x } -> u256 uses (call, holder0, holder1, holder2, holder3, holder4) {
            let (_, scores) = run(x, holder0, holder1, holder2, holder3, holder4)
            scores.argmax() as u256
        }

        Trace { x } -> ([u256; 19], [i32; 2]) uses (
            call,
            holder0,
            holder1,
            holder2,
            holder3,
            holder4,
        ) {
            let (outputs, scores) = run(x, holder0, holder1, holder2, holder3, holder4)
            (outputs.words(), scores.values())
        }
    }
}

/// Every slice's outputs, joined in tree order, and the class scores.
fn run(
    x: [u256; 1],
    holder0: Address,
    holder1: Address,
    holder2: Address,
    holder3: Address,
    holder4: Address,
) -> (Outputs, Scores)
uses (call: Call)
{
    // A malformed input reverts here rather than in a holder.
    let _ = Input::from_words(x)
    var words: [u256; 19] = [0; 19]
    let slice0: [u256; 4] = holder0.static(SliceMsg0::Outputs { x })
    for k in 0 .. 4 {
        words[0 + k] = slice0[k]
    }
    let slice1: [u256; 4] = holder1.static(SliceMsg1::Outputs { x })
    for k in 0 .. 4 {
        words[4 + k] = slice1[k]
    }
    let slice2: [u256; 4] = holder2.static(SliceMsg2::Outputs { x })
    for k in 0 .. 4 {
        words[8 + k] = slice2[k]
    }
    let slice3: [u256; 4] = holder3.static(SliceMsg3::Outputs { x })
    for k in 0 .. 4 {
        words[12 + k] = slice3[k]
    }
    let slice4: [u256; 3] = holder4.static(SliceMsg4::Outputs { x })
    for k in 0 .. 3 {
        words[16 + k] = slice4[k]
    }
    let outputs = Outputs::from_words(words)
    (outputs, outputs.scores(BASE))
}
