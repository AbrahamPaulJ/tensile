fn sample_7_matches_the_reference() {
    assert!(outputs(x: X7) == OUTPUTS7)
    assert!(scores(x: X7) == SCORES7)
    assert!(classify(x: X7) == CLASS7)
    assert!(OUTPUTS7.scores(ingot::BASE) == SCORES7)
}

#[test]
fn sample_7_matches_tree_by_tree() {
    for t in 0 .. TREES {
        let got = tree_output_from_words(tree: tree(t).words(), x: X7.words())
        assert!(got == OUTPUTS7.get(t).raw())
    }
}
