// The compiler packs `INT8` itself and requires the packed literal above.
static_assert(WEIGHTS.is_packed_from(INT8))

/// Layer 1: accumulators with 15 fractional bits, requantised by 9 bits and clamped
/// to 0..127.
pub fn apply(x: Activations<144, 7>) -> Activations<32, 6> {
    dense(weights: WEIGHTS, x: x, bias: BIAS).requantise<9>()
}

/// Output `j` of this layer alone, the activation of one neuron, from row `j` of the weights and
/// bias `j`. It is `tensile::neuron`, the function `apply` runs once per row.
pub fn neuron(row: Row<144, 8>, x: Activations<144, 7>, bias: Q<15>) -> i8 {
    tensile::neuron(row, x, bias).shifted<9>().clamped()
}

/// `neuron` on packed words, the form a contract receives (`docs/spec.md` section 7). Fails
/// if the row or the input is malformed: a padding byte that is not zero, or an input
/// outside 0..127.
pub fn neuron_from_words(row: [u256; 5], x: [u256; 5], bias: i32) -> i8 {
    neuron(
        row: Row::from_words(row),
        x: Activations::from_words(x),
        bias: Q::from_raw(bias),
    )
}

/// Row `j` of the weights.
pub const fn row(_ j: usize) -> Row<144, 8> {
    WEIGHTS.row(j)
}

/// Bias `j`.
pub const fn bias(_ j: usize) -> Q<15> {
    BIAS.at(j)
}
