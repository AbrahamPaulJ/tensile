    [-73316, -47702, -42086, -44841, -22591, 10137, -16473, -40317, -1046, -17780],
)
/// The class of sample 8.
pub const CLASS8: usize = 5

#[test]
fn sample_8_matches_the_reference() {
    assert!(layer1::apply(x: X8) == HIDDEN1_8)
    assert!(layer2::apply(x: HIDDEN1_8) == HIDDEN2_8)
    assert!(layer3::apply(x: HIDDEN2_8) == LOGITS8)
    assert!(classify(x: X8) == CLASS8)
}

#[test]
fn sample_8_matches_neuron_by_neuron() {
    for j in 0 .. 128 {
        let got = layer1::neuron_from_words(
            row: layer1::row(j).words(),
            x: X8.words(),
            bias: layer1::bias(j).raw(),
        )
        assert!(got == HIDDEN1_8.get(j))
    }
    for j in 0 .. 64 {
        let got = layer2::neuron_from_words(
            row: layer2::row(j).words(),
            x: HIDDEN1_8.words(),
            bias: layer2::bias(j).raw(),
        )
        assert!(got == HIDDEN2_8.get(j))
    }
    for j in 0 .. 10 {
        let got = layer3::neuron_from_words(
            row: layer3::row(j).words(),
            x: HIDDEN2_8.words(),
            bias: layer3::bias(j).raw(),
        )
        assert!(got == LOGITS8.at(j).raw())
    }
}

