fn sample_0_matches_the_reference() {
    assert!(layer1::apply(x: X0) == HIDDEN1_0)
    assert!(layer2::apply(x: HIDDEN1_0) == HIDDEN2_0)
    assert!(layer3::apply(x: HIDDEN2_0) == LOGITS0)
