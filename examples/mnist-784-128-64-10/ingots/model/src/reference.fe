            x: HIDDEN1_3.words(),
            bias: layer2::bias(j).raw(),
        )
        assert!(got == HIDDEN2_3.get(j))
    }
    for j in 0 .. 10 {
        let got = layer3::neuron_from_words(
            row: layer3::row(j).words(),
            x: HIDDEN2_3.words(),
            bias: layer3::bias(j).raw(),
        )
        assert!(got == LOGITS3.at(j).raw())
    }
}

