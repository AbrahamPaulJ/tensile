// The compiler packs `INT8` itself and requires the packed literal above.
static_assert(WEIGHTS.is_packed_from(INT8))

/// Layer 3, the last one: its accumulators are the logits, with 12 fractional bits.
pub fn apply(x: Activations<64, 4>) -> Accumulators<10, 12> {
    dense(weights: WEIGHTS, x: x, bias: BIAS)
}

/// Output `j` of this layer alone, the logit of one neuron, from row `j` of the weights and
/// bias `j`. It is `tensile::neuron`, the function `apply` runs once per row.
pub fn neuron(row: Row<64, 8>, x: Activations<64, 4>, bias: Q<12>) -> i32 {
    tensile::neuron(row, x, bias).raw()
}

/// `neuron` on packed words, the form a contract receives (`docs/spec.md` section 7). Fails
/// if the row or the input is malformed: a padding byte that is not zero, or an input
/// outside 0..127.
pub fn neuron_from_words(row: [u256; 2], x: [u256; 2], bias: i32) -> i32 {
    neuron(
        row: Row::from_words(row),
        x: Activations::from_words(x),
        bias: Q::from_raw(bias),
    )
}

/// Row `j` of the weights.
pub const fn row(_ j: usize) -> Row<64, 8> {
    WEIGHTS.row(j)
}

/// Bias `j`.
pub const fn bias(_ j: usize) -> Q<12> {
    BIAS.at(j)
}
