/// Runs the network on an input given as packed words (`docs/spec.md`
/// section 7). A malformed input reverts.
pub msg NetworkMsg {
    /// The predicted class, 0..9.
    #[selector = sol("classify(uint256[25])")]
    Classify { x: [u256; 25] } -> u256,
    /// Every hidden vector as packed words, in layer order, and the logits.
    #[selector = sol("trace(uint256[25])")]
    Trace { x: [u256; 25] } -> ([u256; 4], [u256; 2], [i32; 10]),
}

/// The network 784 -> 128 -> 64 -> 10 on the EVM.
pub contract Network uses (call: Call) {
    rows0: Address,
    rows1: Address,
    rows2: Address,
    rows3: Address,
    rows4: Address,

    init(holder0: Address, holder1: Address, holder2: Address, holder3: Address, holder4: Address)
    uses (mut rows0, mut rows1, mut rows2, mut rows3, mut rows4)
    {
        rows0 = holder0
        rows1 = holder1
        rows2 = holder2
        rows3 = holder3
        rows4 = holder4
    }

    recv NetworkMsg {
        Classify { x } -> u256 uses (call, rows0, rows1, rows2, rows3, rows4) {
            let (_, _, logits) = forward(
                x: Activations::from_words(x),
                rows0,
                rows1,
                rows2,
                rows3,
                rows4,
            )
            logits.argmax() as u256
        }

        Trace { x } -> ([u256; 4], [u256; 2], [i32; 10])
        uses (call, rows0, rows1, rows2, rows3, rows4)
        {
            let (hidden1, hidden2, logits) = forward(
                x: Activations::from_words(x),
                rows0,
                rows1,
                rows2,
                rows3,
                rows4,
            )
            (hidden1.words(), hidden2.words(), logits.values())
        }
    }
}

/// The forward pass: every hidden vector and the logits. One function for both handlers, so
/// that the weights of the later layers are in the contract's code once.
fn forward(
    x: Input,
    rows0: Address,
    rows1: Address,
    rows2: Address,
    rows3: Address,
    rows4: Address,
) -> (Activations<128, 5>, Activations<64, 4>, Logits)
uses (call: Call)
{
    let hidden1 = first_layer(x, rows0, rows1, rows2, rows3, rows4)
    let hidden2 = layer2::apply(x: hidden1)
    let logits = layer3::apply(x: hidden2)
    (hidden1, hidden2, logits)
}

/// Layer 1, one neuron at a time: `layer1::neuron` on a row and bias fetched from
/// the weight contract that holds them.
fn first_layer(
    x: Input,
    rows0: Address,
    rows1: Address,
    rows2: Address,
    rows3: Address,
    rows4: Address,
) -> Activations<128, 5>
uses (call: Call)
{
    var values: [i8; 128] = [0; 128]
    for j in 0 .. 128 {
        let holder = if j < 28 {
            rows0
        } else if j < 56 {
            rows1
        } else if j < 84 {
            rows2
        } else if j < 112 { rows3 } else { rows4 }
        let (row, bias) = holder.static(RowMsg::Row { j })
        values[j] = layer1::neuron(row: Row::from_words(row), x, bias: Q::from_raw(bias))
    }
    Activations::pack(values)
}
