//! `Arbiter`: optimistic verification of inference claims
//! (`docs/spec-dispute.md`).
//!
//! Anyone posts a claimed inference with a bond; anyone can prove it wrong
//! before the deadline by re-running one neuron or the argmax on-chain, with
//! the model ingot's `neuron_from_words`: the code the forward pass runs. The
//! filter of a convolution is re-run on the one window it reads
//! (`docs/spec-dispute.md` section 11). The lifecycle rule is `dispute::step`, a pure function, and `dispute::shares`
//! says how a bond is shared out: all of it back on finalising; on a slash,
//! half to the challenger and the rest burned, so that a false claim costs
//! at least half its bond even when its own claimant slashes it. This contract
//! reads the clock, loads and stores the claim, and moves credits. Credits are pulled
//! with `withdraw`, the only handler that sends ETH, which its effect
//! signature shows (`mut call`).
use core::result::Result
use dispute::{Action, Payee, Rejection, Status, Transition, shares, step}
use ingot::commitment::leaf
use ingot::record::{Record, dynamic, logits_hash}
use ingot::vectors::{span_verify, word_root, word_verify}
use ingot::signals::{
    BondTooSmall,
    ClaimNotOpen,
    ClassOutOfRange,
    ClassSlashed,
    Claimed,
    FilterSlashed,
    Finalized,
    InputMismatch,
    MalformedHidden,
    MalformedInput,
    NeuronOutOfRange,
    NeuronSlashed,
    NoFraud,
    NotCommitted,
    NotFinal,
    NothingToWithdraw,
    OutputMismatch,
    PositionOutOfRange,
    TooEarly,
    TooLate,
    TransferFailed,
    UnknownClaim,
    Withdrawn,
}
use model::{Input, Logits, layer1, layer2, layer3, layer4, layer5}
use std::abi::{Bytes32, DynArray}
use std::evm::{Address, Call, Ctx, Duration, Log, StorageMap, Timestamp, Wei, merkle, wei}
use tensile::Activations

/// The output of layer 1.
type Hidden1 = Activations<4496, 6>

/// The output of layer 2.
type Hidden2 = Activations<1120, 7>

/// The output of layer 3.
type Hidden3 = Activations<272, 4>

/// The output of layer 4.
type Hidden4 = Activations<32, 4>

/// Number of hidden neurons (layer 1 outputs).
const HIDDEN1: u256 = 4496

/// Number of hidden neurons (layer 2 outputs).
const HIDDEN2: u256 = 1120

/// Number of hidden neurons (layer 3 outputs).
const HIDDEN3: u256 = 272

/// Number of hidden neurons (layer 4 outputs).
const HIDDEN4: u256 = 32

/// Number of filters of layer 1, a convolution.
const FILTERS1: u256 = 16

/// Number of positions of layer 1's output.
const POSITIONS1: u256 = 281

/// Number of filters of layer 2, a convolution.
const FILTERS2: u256 = 16

/// Number of positions of layer 2's output.
const POSITIONS2: u256 = 70

/// Number of filters of layer 3, a convolution.
const FILTERS3: u256 = 16

/// Number of positions of layer 3's output.
const POSITIONS3: u256 = 17

/// Number of classes (layer 5 outputs).
const CLASSES: u8 = 3

/// The arbiter's interface. Vectors are packed words (`docs/spec.md` section
/// 7); `uint8` for a class, `int32` for a bias or logit, `bytes32[]` for a
/// Merkle proof (siblings from the leaf up, as OpenZeppelin's `MerkleProof`).
pub msg ArbiterMsg {
    /// Posts a claim with at least `bond()` attached: for input `x0`, the
    /// hidden activations are `hidden1`, `hidden2`, `hidden3` and `hidden4`,
    /// the logits `logits`, the class `class`. Returns the claim number.
    #[selector = sol(
        "claim(uint256[9],uint256[141],uint256[35],uint256[9],uint256[1],int32[3],uint8)",
    )]
    Claim {
        x0: [u256; 9],
        hidden1: [u256; 141],
        hidden2: [u256; 35],
        hidden3: [u256; 9],
        hidden4: [u256; 1],
        logits: [i32; 3],
        class: u8,
    } -> u256,
    /// Proves claim `id` wrong at output `position * 16 + filter` of layer 1, a
    /// convolution: `span` must be the 2 words of `x0` from
    /// `span_first(position)` on, each with its proof against the claim's word
    /// root (4 nodes per word, in order), `word` the word of `hidden1` that
    /// holds the output, with its proof; `row`, `bias` and `proof` filter
    /// `filter` of layer 1. Reverts unless the filter recomputes to another
    /// value.
    #[selector = sol(
        "challengeFilter1(uint256,uint256,uint256,uint256[2],uint256[8],uint256,uint256[8],uint256[1],int32,bytes32[])",
    )]
    ChallengeFilter1 {
        id: u256,
        filter: u256,
        position: u256,
        span: [u256; 2],
        span_proof: [u256; 8],
        word: u256,
        word_proof: [u256; 8],
        row: [u256; 1],
        bias: i32,
        proof: DynArray<Bytes32>,
    },
    /// Proves claim `id` wrong at output `position * 16 + filter` of layer 2, a
    /// convolution: `span` must be the 3 words of `hidden1` from
    /// `span_first(position)` on, each with its proof against the claim's word
    /// root (8 nodes per word, in order), `word` the word of `hidden2` that
    /// holds the output, with its proof; `row`, `bias` and `proof` filter
    /// `filter` of layer 2. Reverts unless the filter recomputes to another
    /// value.
    #[selector = sol(
        "challengeFilter2(uint256,uint256,uint256,uint256[3],uint256[24],uint256,uint256[6],uint256[2],int32,bytes32[])",
    )]
    ChallengeFilter2 {
        id: u256,
        filter: u256,
        position: u256,
        span: [u256; 3],
        span_proof: [u256; 24],
        word: u256,
        word_proof: [u256; 6],
        row: [u256; 2],
        bias: i32,
        proof: DynArray<Bytes32>,
    },
    /// Proves claim `id` wrong at output `position * 16 + filter` of layer 3, a
    /// convolution: `span` must be the 3 words of `hidden2` from
    /// `span_first(position)` on, each with its proof against the claim's word
    /// root (6 nodes per word, in order), `word` the word of `hidden3` that
    /// holds the output, with its proof; `row`, `bias` and `proof` filter
    /// `filter` of layer 3. Reverts unless the filter recomputes to another
    /// value.
    #[selector = sol(
        "challengeFilter3(uint256,uint256,uint256,uint256[3],uint256[18],uint256,uint256[4],uint256[2],int32,bytes32[])",
    )]
    ChallengeFilter3 {
        id: u256,
        filter: u256,
        position: u256,
        span: [u256; 3],
        span_proof: [u256; 18],
        word: u256,
        word_proof: [u256; 4],
        row: [u256; 2],
        bias: i32,
        proof: DynArray<Bytes32>,
    },
    /// Proves claim `id` wrong at neuron `j` of layer 4: `hidden3` and
    /// `hidden4` must be the committed vectors, `row`, `bias` and `proof` a
    /// committed neuron of layer 4. Reverts unless the neuron recomputes to
    /// another value.
    #[selector = sol(
        "challengeNeuron4(uint256,uint256,uint256[9],uint256[1],uint256[9],int32,bytes32[])",
    )]
    ChallengeNeuron4 {
        id: u256,
        j: u256,
        hidden3: [u256; 9],
        hidden4: [u256; 1],
        row: [u256; 9],
        bias: i32,
        proof: DynArray<Bytes32>,
    },
    /// Proves claim `id` wrong at logit `j`, from the committed vector
    /// `hidden4`.
    #[selector = sol(
        "challengeNeuron5(uint256,uint256,uint256[1],int32[3],uint256[1],int32,bytes32[])",
    )]
    ChallengeNeuron5 {
        id: u256,
        j: u256,
        hidden4: [u256; 1],
        logits: [i32; 3],
        row: [u256; 1],
        bias: i32,
        proof: DynArray<Bytes32>,
    },
    /// Proves claim `id` wrong at the class: the argmax of the committed
    /// logits (lowest index on a tie) is not the claimed class.
    #[selector = sol("challengeClass(uint256,int32[3])")]
    ChallengeClass { id: u256, logits: [i32; 3] },
    /// Closes claim `id` at or after its deadline and credits the whole bond
    /// back to the claimant.
    #[selector = sol("finalize(uint256)")]
    Finalize { id: u256 },
    /// Sends the caller's credits to the caller. Returns the amount.
    #[selector = sol("withdraw()")]
    Withdraw -> Wei,
    /// The class of a `Final` claim. Reverts for any other claim.
    #[selector = sol("result(uint256)")]
    ResultOf { id: u256 } -> u8,
    /// Number of claims posted so far; claims are numbered from 0.
    #[selector = sol("claimCount()")]
    ClaimCount -> u256,
    /// Claimant, bond, deadline, class and status code (1 open, 2 slashed,
    /// 3 final) of claim `id`.
    #[selector = sol("claimInfo(uint256)")]
    ClaimInfo { id: u256 } -> (Address, Wei, Timestamp, u8, u8),
    /// The commitments of claim `id`: the word roots of the input and of each
    /// hidden vector in layer order, then the hash of the logits.
    #[selector = sol("claimHashes(uint256)")]
    ClaimHashes { id: u256 } -> (u256, u256, u256, u256, u256, u256),
    /// What `account` can withdraw.
    #[selector = sol("creditOf(address)")]
    CreditOf { account: Address } -> Wei,
    /// The model root the arbiter was deployed with.
    #[selector = sol("modelRoot()")]
    ModelRoot -> u256,
    /// The bond a claim must attach.
    #[selector = sol("bond()")]
    Bond -> Wei,
    /// The total burned by slashes: half of every slashed bond, rounded up.
    /// It stays in the contract and nobody can withdraw it.
    #[selector = sol("burned()")]
    Burned -> Wei,
    /// How long a claim stays challengeable.
    #[selector = sol("window()")]
    Window -> Duration,
}

/// The arbiter for one model: deployed with the model root, the bond and the
/// challenge window. Each handler names the effects it needs: only `Withdraw`
/// can move ETH (`mut call`); the views touch nothing but storage.
pub contract Arbiter uses (ctx: Ctx, call: mut Call, log: mut Log) {
    root: u256,
    bond: Wei,
    window: Duration,
    mut count: u256,
    mut claims: StorageMap<u256, Record>,
    mut credits: StorageMap<Address, Wei>,
    mut burned: Wei,

    init(model_root: u256, bond_required: Wei, challenge_window: Duration)
    uses (mut root, mut bond, mut window)
    {
        root = model_root
        bond = bond_required
        window = challenge_window
    }

    recv ArbiterMsg {
        #[payable]
        Claim { x0, hidden1, hidden2, hidden3, hidden4, logits, class } -> u256
        uses (ctx, bond, window, mut count, mut claims, mut log)
        {
            let paid = ctx.value()
            if paid < bond {
                revert_error(BondTooSmall { sent: paid, required: bond })
            }
            if !Input::well_formed(x0) {
                revert_error(MalformedInput {})
            }
            if !Hidden1::well_formed(hidden1) {
                revert_error(MalformedHidden {})
            }
            if !Hidden2::well_formed(hidden2) {
                revert_error(MalformedHidden {})
            }
            if !Hidden3::well_formed(hidden3) {
                revert_error(MalformedHidden {})
            }
            if !Hidden4::well_formed(hidden4) {
                revert_error(MalformedHidden {})
            }
            if class >= CLASSES {
                revert_error(ClassOutOfRange { class })
            }
            let id = count
            count = id + 1
            let claimant = ctx.caller()
            let deadline = ctx.timestamp() + window
            claims[id] = Record {
                claimant,
                class,
                status: Status::Open.code(),
                bond: paid,
                deadline,
                x0_hash: word_root<9>(x0),
                hidden1_hash: word_root<141>(hidden1),
                hidden2_hash: word_root<35>(hidden2),
                hidden3_hash: word_root<9>(hidden3),
                hidden4_hash: word_root<1>(hidden4),
                logits_hash: logits_hash(logits),
            }
            log.emit(
                Claimed {
                    id,
                    claimant,
                    x0: dynamic(x0),
                    hidden1: dynamic(hidden1),
                    hidden2: dynamic(hidden2),
                    hidden3: dynamic(hidden3),
                    hidden4: dynamic(hidden4),
                    logits: dynamic(logits),
                    class,
                    bond: paid,
                    deadline,
                },
            )
            id
        }

        ChallengeFilter1 {
            id,
            filter,
            position,
            span,
            span_proof,
            word,
            word_proof,
            row,
            bias,
            proof,
        }
        uses (ctx, root, count, mut claims, mut credits, mut burned, mut log)
        {
            let record = with (u256 = count) {
                load(id)
            }
            if filter >= FILTERS1 {
                revert_error(NeuronOutOfRange { neuron: filter })
            }
            if position >= POSITIONS1 {
                revert_error(PositionOutOfRange { position })
            }
            // Both were checked above, so narrowing them loses nothing.
            let p: usize = position.downcast_truncate()
            let index: usize = (position * FILTERS1 + filter).downcast_truncate()
            // The words of the input that hold the window, each at its own index.
            let first = layer1::span_first(p)
            if !span_verify<2, 4, 8>(record.x0_hash, first, span, span_proof) {
                revert_error(InputMismatch {})
            }
            // The claimed value is byte `index % 32` of word `index / 32` of the output.
            if !word_verify<8>(record.hidden1_hash, index / 32, word, word_proof) {
                revert_error(OutputMismatch {})
            }
            if !merkle::verify(
                proof,
                root,
                leaf: leaf(layer: 1, neuron: filter, bias, row),
            ) {
                revert_error(NotCommitted {})
            }
            let recomputed = layer1::output_from_span(row, x: span, first, position: p, bias)
            let claimed = Activations<32, 6>::from_words([word]).get(index % 32)
            let challenger = ctx.caller()
            settle(
                id,
                record,
                now: ctx.timestamp(),
                action: Action::Challenge(recomputed != claimed),
                challenger,
            )
            log.emit(
                FilterSlashed { id, challenger, layer: 1, filter, position },
            )
        }

        ChallengeFilter2 {
            id,
            filter,
            position,
            span,
            span_proof,
            word,
            word_proof,
            row,
            bias,
            proof,
        }
        uses (ctx, root, count, mut claims, mut credits, mut burned, mut log)
        {
            let record = with (u256 = count) {
                load(id)
            }
            if filter >= FILTERS2 {
                revert_error(NeuronOutOfRange { neuron: filter })
            }
            if position >= POSITIONS2 {
                revert_error(PositionOutOfRange { position })
            }
            // Both were checked above, so narrowing them loses nothing.
            let p: usize = position.downcast_truncate()
            let index: usize = (position * FILTERS2 + filter).downcast_truncate()
            // The words of the input that hold the window, each at its own index.
            let first = layer2::span_first(p)
            if !span_verify<3, 8, 24>(record.hidden1_hash, first, span, span_proof) {
                revert_error(InputMismatch {})
            }
            // The claimed value is byte `index % 32` of word `index / 32` of the output.
            if !word_verify<6>(record.hidden2_hash, index / 32, word, word_proof) {
                revert_error(OutputMismatch {})
            }
            if !merkle::verify(
                proof,
                root,
                leaf: leaf(layer: 2, neuron: filter, bias, row),
            ) {
                revert_error(NotCommitted {})
            }
            let recomputed = layer2::output_from_span(row, x: span, first, position: p, bias)
            let claimed = Activations<32, 7>::from_words([word]).get(index % 32)
            let challenger = ctx.caller()
            settle(
                id,
                record,
                now: ctx.timestamp(),
                action: Action::Challenge(recomputed != claimed),
                challenger,
            )
            log.emit(
                FilterSlashed { id, challenger, layer: 2, filter, position },
            )
        }

        ChallengeFilter3 {
            id,
            filter,
            position,
            span,
            span_proof,
            word,
            word_proof,
            row,
            bias,
            proof,
        }
        uses (ctx, root, count, mut claims, mut credits, mut burned, mut log)
        {
            let record = with (u256 = count) {
                load(id)
            }
            if filter >= FILTERS3 {
                revert_error(NeuronOutOfRange { neuron: filter })
            }
            if position >= POSITIONS3 {
                revert_error(PositionOutOfRange { position })
            }
            // Both were checked above, so narrowing them loses nothing.
            let p: usize = position.downcast_truncate()
            let index: usize = (position * FILTERS3 + filter).downcast_truncate()
            // The words of the input that hold the window, each at its own index.
            let first = layer3::span_first(p)
            if !span_verify<3, 6, 18>(record.hidden2_hash, first, span, span_proof) {
                revert_error(InputMismatch {})
            }
            // The claimed value is byte `index % 32` of word `index / 32` of the output.
            if !word_verify<4>(record.hidden3_hash, index / 32, word, word_proof) {
                revert_error(OutputMismatch {})
            }
            if !merkle::verify(
                proof,
                root,
                leaf: leaf(layer: 3, neuron: filter, bias, row),
            ) {
                revert_error(NotCommitted {})
            }
            let recomputed = layer3::output_from_span(row, x: span, first, position: p, bias)
            let claimed = Activations<32, 4>::from_words([word]).get(index % 32)
            let challenger = ctx.caller()
            settle(
                id,
                record,
                now: ctx.timestamp(),
                action: Action::Challenge(recomputed != claimed),
                challenger,
            )
            log.emit(
                FilterSlashed { id, challenger, layer: 3, filter, position },
            )
        }

        ChallengeNeuron4 { id, j, hidden3, hidden4, row, bias, proof }
        uses (ctx, root, count, mut claims, mut credits, mut burned, mut log)
        {
            // Two `u256` effects are in scope here (`root` and `count`), so the one
            // `load` reads is named: Fe 26.7.0 will not pick between them.
            let record = with (u256 = count) {
                load(id)
            }
            if j >= HIDDEN4 {
                revert_error(NeuronOutOfRange { neuron: j })
            }
            if word_root<9>(hidden3) != record.hidden3_hash {
                revert_error(InputMismatch {})
            }
            if word_root<1>(hidden4) != record.hidden4_hash {
                revert_error(OutputMismatch {})
            }
            if !merkle::verify(proof, root, leaf: leaf(layer: 4, neuron: j, bias, row)) {
                revert_error(NotCommitted {})
            }
            let recomputed = layer4::neuron_from_words(row, x: hidden3, bias)
            // `j < HIDDEN4` was checked above, so narrowing it loses nothing.
            let claimed = Hidden4::from_words(hidden4).get(j.downcast_truncate())
            let challenger = ctx.caller()
            settle(
                id,
                record,
                now: ctx.timestamp(),
                action: Action::Challenge(recomputed != claimed),
                challenger,
            )
            log.emit(NeuronSlashed { id, challenger, layer: 4, neuron: j })
        }

        ChallengeNeuron5 { id, j, hidden4, logits, row, bias, proof }
        uses (ctx, root, count, mut claims, mut credits, mut burned, mut log)
        {
            // Two `u256` effects are in scope here (`root` and `count`), so the one
            // `load` reads is named: Fe 26.7.0 will not pick between them.
            let record = with (u256 = count) {
                load(id)
            }
            if j >= CLASSES as u256 {
                revert_error(NeuronOutOfRange { neuron: j })
            }
            if word_root<1>(hidden4) != record.hidden4_hash {
                revert_error(InputMismatch {})
            }
            if logits_hash(logits) != record.logits_hash {
                revert_error(OutputMismatch {})
            }
            if !merkle::verify(proof, root, leaf: leaf(layer: 5, neuron: j, bias, row)) {
                revert_error(NotCommitted {})
            }
            let recomputed = layer5::neuron_from_words(row, x: hidden4, bias)
            // `j < CLASSES` was checked above, so narrowing it loses nothing.
            let claimed = logits[j.downcast_truncate()]
            let challenger = ctx.caller()
            settle(
                id,
                record,
                now: ctx.timestamp(),
                action: Action::Challenge(recomputed != claimed),
                challenger,
            )
            log.emit(NeuronSlashed { id, challenger, layer: 5, neuron: j })
        }

        ChallengeClass { id, logits } uses (
            ctx,
            count,
            mut claims,
            mut credits,
            mut burned,
            mut log,
        ) {
            let record = load(id)
            if logits_hash(logits) != record.logits_hash {
                revert_error(OutputMismatch {})
            }
            let fraud = Logits::from_raw(logits).argmax() != record.class as usize
            let challenger = ctx.caller()
            settle(
                id,
                record,
                now: ctx.timestamp(),
                action: Action::Challenge(fraud),
                challenger,
            )
            log.emit(ClassSlashed { id, challenger })
        }

        Finalize { id } uses (ctx, count, mut claims, mut credits, mut burned, mut log) {
            let record = load(id)
            settle(
                id,
                record,
                now: ctx.timestamp(),
                action: Action::Finalize,
                challenger: ctx.caller(),
            )
            log.emit(Finalized { id, class: record.class })
        }

        Withdraw -> Wei uses (ctx, mut call, mut credits, mut log) {
            let account = ctx.caller()
            let amount = credits[account]
            if amount == Wei::zero() {
                revert_error(NothingToWithdraw {})
            }
            // State first, then the transfer; a failed transfer reverts both.
            credits[account] = Wei::zero()
            if !call.send_value(addr: account, gas: ctx.gas(), value: amount).success() {
                revert_error(TransferFailed {})
            }
            log.emit(Withdrawn { account, amount })
            amount
        }

        ResultOf { id } -> u8 uses (count, claims) {
            let record = load(id)
            if record.status != Status::Final.code() {
                revert_error(NotFinal { id })
            }
            record.class
        }

        ClaimCount -> u256 uses (count) {
            count
        }

        ClaimInfo { id } -> (Address, Wei, Timestamp, u8, u8)
        uses (count, claims)
        {
            let record = load(id)
            (record.claimant, record.bond, record.deadline, record.class, record.status)
        }

        ClaimHashes { id } -> (u256, u256, u256, u256, u256, u256)
        uses (count, claims)
        {
            let record = load(id)
            (
                record.x0_hash,
                record.hidden1_hash,
                record.hidden2_hash,
                record.hidden3_hash,
                record.hidden4_hash,
                record.logits_hash,
            )
        }

        CreditOf { account } -> Wei uses (credits) {
            credits[account]
        }

        ModelRoot -> u256 uses (root) {
            root
        }

        Bond -> Wei uses (bond) {
            bond
        }

        Burned -> Wei uses (burned) {
            burned
        }

        Window -> Duration uses (window) {
            window
        }
    }
}

/// Claim `id`, or `UnknownClaim`.
fn load(_ id: u256) -> Record
uses (count: u256, claims: StorageMap<u256, Record>)
{
    if id >= count {
        revert_error(UnknownClaim { id })
    }
    claims[id]
}

/// Applies the lifecycle rule to claim `id`: stores the new status, credits
/// the payee its share of the bond and adds the rest to `burned`, or reverts
/// with the rule's reason. `challenger` is the caller; it is paid only when
/// the rule says so. `burned` grows only on a slash; finalising burns nothing.
fn settle(_ id: u256, _ record: Record, now: Timestamp, action: Action, challenger: Address)
uses (claims: mut StorageMap<u256, Record>, credits: mut StorageMap<Address, Wei>, burned: mut Wei)
{
    let claim = dispute::Claim {
        status: Status::from_code(record.status),
        deadline: record.deadline.as_seconds(),
    }
    match step(claim, now: now.as_seconds(), action) {
        Result::Err(why) => {
            match why {
                Rejection::NotOpen => revert_error(ClaimNotOpen { id }),
                Rejection::TooLate => revert_error(TooLate { deadline: record.deadline }),
                Rejection::TooEarly => revert_error(TooEarly { deadline: record.deadline }),
                Rejection::NoFraud => revert_error(NoFraud {}),
            }
        },
        Result::Ok(transition) => {
            claims[id].status = transition.status.code()
            let payee = match transition.bond_to {
                Payee::Challenger => challenger,
                Payee::Claimant => record.claimant,
            }
            let (paid, burnt) = shares(record.bond.as_wei(), transition)
            credits[payee] = credits[payee] + wei(paid)
            if burnt != 0 {
                burned = burned + wei(burnt)
            }
        },
    }
}
