#[test(balance = 10_000_000)]
fn a_wrong_value_of_hidden_layer_4_is_slashed_by_its_neuron_only()
uses (evm: mut Evm)
{
    let arbiter = deploy(window: LONG)
    let claimed = wrong_hidden4(5)
    let id = post(arbiter, claimed)
    // The other neurons of layer 4 recompute to the committed values.
    assert!(failed_with<NoFraud>(challenge4(arbiter, id, 4, claimed)))
    assert!(failed_with<NoFraud>(challenge4(arbiter, id, 6, claimed)))
    // The class is still the argmax of the committed logits.
    assert!(
        failed_with<NoFraud>(challenge_class(arbiter, id, claimed)),
    )
    assert!(status(arbiter, id) == OPEN)

    assert!(challenge4(arbiter, id, 5, claimed).success())
    assert!(status(arbiter, id) == SLASHED)
    assert!(slashed_once(arbiter))
    // Terminal: nothing moves it again, and it has no result.
    assert!(
        failed_with<ClaimNotOpen>(challenge4(arbiter, id, 5, claimed)),
    )
    assert!(failed_with<ClaimNotOpen>(finalize(arbiter, id)))
    assert!(
        failed_with<NotFinal>(attempt(arbiter, ArbiterMsg::ResultOf { id })),
    )
    assert!(slashed_once(arbiter))
}

#[test(balance = 10_000_000)]
fn a_wrong_logit_is_slashed_by_its_neuron_only() uses (evm: mut Evm) {
    let arbiter = deploy(window: LONG)
    let claimed = wrong_logit(1)
    let id = post(arbiter, claimed)
    assert!(failed_with<NoFraud>(filter1(arbiter, id, 0, 0, claimed)))
    assert!(failed_with<NoFraud>(filter2(arbiter, id, 0, 0, claimed)))
    assert!(failed_with<NoFraud>(filter3(arbiter, id, 0, 0, claimed)))
    assert!(failed_with<NoFraud>(challenge4(arbiter, id, 0, claimed)))
    assert!(failed_with<NoFraud>(challenge5(arbiter, id, 0, claimed)))
    // Logit 1 plus one does not change the argmax, so the class is consistent
    // with the wrong logits: only the neuron challenge catches this claim.
    assert!(
        failed_with<NoFraud>(challenge_class(arbiter, id, claimed)),
    )
    assert!(challenge5(arbiter, id, 1, claimed).success())
    assert!(status(arbiter, id) == SLASHED)
    assert!(slashed_once(arbiter))
}

#[test(balance = 10_000_000)]
fn a_wrong_class_is_slashed_by_the_class_challenge_only() uses (evm: mut Evm) {
    let arbiter = deploy(window: LONG)
    let claimed = wrong_class()
    let id = post(arbiter, claimed)
    assert!(failed_with<NoFraud>(filter1(arbiter, id, 0, 0, claimed)))
    assert!(failed_with<NoFraud>(filter2(arbiter, id, 0, 0, claimed)))
    assert!(failed_with<NoFraud>(filter3(arbiter, id, 0, 0, claimed)))
    assert!(failed_with<NoFraud>(challenge4(arbiter, id, 0, claimed)))
    assert!(failed_with<NoFraud>(challenge5(arbiter, id, 0, claimed)))
    assert!(challenge_class(arbiter, id, claimed).success())
    assert!(status(arbiter, id) == SLASHED)
    assert!(slashed_once(arbiter))
}

#[test(balance = 10_000_000)]
fn malformed_claims_are_rejected() uses (evm: mut Evm) {
    let arbiter = deploy(window: LONG)
    var high_input = honest()
    high_input.x0[0] |= 0x80 << 248
    var high_hidden1 = honest()
    high_hidden1.hidden1[0] |= 0x80 << 248
    var high_hidden2 = honest()
    high_hidden2.hidden2[0] |= 0x80 << 248
    var high_hidden3 = honest()
    high_hidden3.hidden3[0] |= 0x80 << 248
    var high_hidden4 = honest()
    high_hidden4.hidden4[0] |= 0x80 << 248
    var hidden_padding = honest()
    hidden_padding.hidden1[0] = 0
    var class = honest()
    class.class = 3
    assert!(
        failed_with<MalformedInput>(
            evm.try_call(
                addr: arbiter,
                gas: GAS,
                value: BOND,
                message: claim_message(high_input),
            ),
        ),
    )
    assert!(
        failed_with<MalformedHidden>(
            evm.try_call(
                addr: arbiter,
                gas: GAS,
                value: BOND,
                message: claim_message(high_hidden1),
            ),
        ),
    )
    assert!(
        failed_with<MalformedHidden>(
            evm.try_call(
                addr: arbiter,
                gas: GAS,
                value: BOND,
                message: claim_message(high_hidden2),
            ),
        ),
    )
    assert!(
        failed_with<MalformedHidden>(
            evm.try_call(
                addr: arbiter,
                gas: GAS,
                value: BOND,
                message: claim_message(high_hidden3),
            ),
        ),
    )
    assert!(
        failed_with<MalformedHidden>(
            evm.try_call(
                addr: arbiter,
                gas: GAS,
                value: BOND,
                message: claim_message(high_hidden4),
            ),
        ),
    )
    assert!(
        failed_with<ClassOutOfRange>(
            evm.try_call(
                addr: arbiter,
                gas: GAS,
                value: BOND,
                message: claim_message(class),
            ),
        ),
    )
    assert!(
        failed_with<BondTooSmall>(
            evm.try_call(
                addr: arbiter,
                gas: GAS,
                value: BOND - wei(1),
                message: claim_message(honest()),
            ),
        ),
    )
    assert!(claim_count(arbiter) == 0)
    // A hidden vector with a word of zeros is well formed, whatever it claims.
    assert!(
        evm.try_call(
            addr: arbiter,
            gas: GAS,
            value: BOND,
            message: claim_message(hidden_padding),
        )
            .success(),
    )
    assert!(claim_count(arbiter) == 1)
}

#[test(balance = 10_000_000)]
fn a_wrong_filter_challenge_is_rejected() uses (evm: mut Evm) {
    let arbiter = deploy(window: LONG)
    let claimed = wrong_hidden1(2241)
    let id = post(arbiter, claimed)
    // The proof of another filter, another bias, another filter's row: none verifies.
    assert!(
        failed_with<NotCommitted>(
            attempt(
                arbiter,
                filter1_message(
                    id,
                    named: 1,
                    position: 140,
                    claimed,
                    row_of: 1,
                    bias_offset: 0,
                    proof_of: 2,
                    span_shift: 0,
                    word_shift: 0,
                ),
            ),
        ),
    )
    assert!(
        failed_with<NotCommitted>(
            attempt(
                arbiter,
                filter1_message(
                    id,
                    named: 1,
                    position: 140,
                    claimed,
                    row_of: 1,
                    bias_offset: 1,
                    proof_of: 1,
                    span_shift: 0,
                    word_shift: 0,
                ),
            ),
        ),
    )
    assert!(
        failed_with<NotCommitted>(
            attempt(
                arbiter,
                filter1_message(
                    id,
                    named: 1,
                    position: 140,
                    claimed,
                    row_of: 2,
                    bias_offset: 0,
                    proof_of: 1,
                    span_shift: 0,
                    word_shift: 0,
                ),
            ),
        ),
    )
    // A filter or a position that the layer does not have.
    assert!(
        failed_with<NeuronOutOfRange>(
            attempt(
                arbiter,
                filter1_message(
                    id,
                    named: 16,
                    position: 140,
                    claimed,
                    row_of: 1,
                    bias_offset: 0,
                    proof_of: 1,
                    span_shift: 0,
                    word_shift: 0,
                ),
            ),
        ),
    )
    assert!(
        failed_with<PositionOutOfRange>(
            attempt(
                arbiter,
                filter1_message(
                    id,
                    named: 1,
                    position: 281,
                    claimed,
                    row_of: 1,
                    bias_offset: 0,
                    proof_of: 1,
                    span_shift: 0,
                    word_shift: 0,
                ),
            ),
        ),
    )
    // Genuine words with genuine proofs, opened at the wrong place: the input words
    // that follow the window's, and the output word after the claimed value's.
    assert!(
        failed_with<InputMismatch>(
            attempt(
                arbiter,
                filter1_message(
                    id,
                    named: 1,
                    position: 0,
                    claimed,
                    row_of: 1,
                    bias_offset: 0,
                    proof_of: 1,
                    span_shift: 1,
                    word_shift: 0,
                ),
            ),
        ),
    )
    assert!(
        failed_with<OutputMismatch>(
            attempt(
                arbiter,
                filter1_message(
                    id,
                    named: 1,
                    position: 140,
                    claimed,
                    row_of: 1,
                    bias_offset: 0,
                    proof_of: 1,
                    span_shift: 0,
                    word_shift: 1,
                ),
            ),
        ),
    )
    assert!(status(arbiter, id) == OPEN)
    assert!(filter1(arbiter, id, 1, 140, claimed).success())
}

#[test(balance = 10_000_000)]
fn vectors_that_do_not_match_the_commitments_are_rejected()
uses (evm: mut Evm)
{
    let arbiter = deploy(window: LONG)
    let claimed = honest()
    let id = post(arbiter, claimed)
    var other_input = claimed
    other_input.x0 = reference::X1.words()
    var other_hidden1 = claimed
    other_hidden1.hidden1 = reference::HIDDEN1_1.words()
    var other_hidden2 = claimed
    other_hidden2.hidden2 = reference::HIDDEN2_1.words()
    var other_hidden3 = claimed
    other_hidden3.hidden3 = reference::HIDDEN3_1.words()
    var other_hidden4 = claimed
    other_hidden4.hidden4 = reference::HIDDEN4_1.words()
    var other_logits = claimed
    other_logits.logits = reference::LOGITS1.values()
    assert!(
        failed_with<InputMismatch>(filter1(arbiter, id, 0, 0, other_input)),
    )
    assert!(
        failed_with<OutputMismatch>(filter1(arbiter, id, 0, 0, other_hidden1)),
    )
    assert!(
        failed_with<InputMismatch>(filter2(arbiter, id, 0, 0, other_hidden1)),
    )
    assert!(
        failed_with<OutputMismatch>(filter2(arbiter, id, 0, 0, other_hidden2)),
    )
    assert!(
        failed_with<InputMismatch>(filter3(arbiter, id, 0, 0, other_hidden2)),
    )
    assert!(
        failed_with<OutputMismatch>(filter3(arbiter, id, 0, 0, other_hidden3)),
    )
    assert!(
        failed_with<InputMismatch>(challenge4(arbiter, id, 0, other_hidden3)),
    )
    assert!(
        failed_with<OutputMismatch>(challenge4(arbiter, id, 0, other_hidden4)),
    )
    assert!(
        failed_with<InputMismatch>(challenge5(arbiter, id, 0, other_hidden4)),
    )
    assert!(
        failed_with<OutputMismatch>(challenge5(arbiter, id, 0, other_logits)),
    )
    assert!(
        failed_with<OutputMismatch>(challenge_class(arbiter, id, other_logits)),
    )
    assert!(
        failed_with<UnknownClaim>(challenge_class(arbiter, id: 7, claimed)),
    )
    assert!(status(arbiter, id) == OPEN)
}

#[test(balance = 10_000_000)]
fn finalising_after_the_window_returns_the_bond() uses (evm: mut Evm) {
    // A window of zero: the deadline is now, so a challenge is already too
    // late and finalising is allowed.
    let arbiter = deploy(window: seconds(0))
    let id = post(arbiter, wrong_class())
    assert!(
        failed_with<TooLate>(challenge_class(arbiter, id, wrong_class())),
    )
    assert!(finalize(arbiter, id).success())
    assert!(status(arbiter, id) == FINAL)
    let result: u8 = evm
        .call(
            addr: arbiter,
            gas: GAS,
            value: Wei::zero(),
            message: ArbiterMsg::ResultOf { id },
        )
    assert!(result == wrong_class().class)
    assert!(failed_with<ClaimNotOpen>(finalize(arbiter, id)))
    assert!(
        failed_with<ClaimNotOpen>(challenge_class(arbiter, id, wrong_class())),
    )
    assert!(credit(arbiter, account: evm.address()) == BOND)
    assert!(burned(arbiter) == Wei::zero())
    assert!(evm.balance(arbiter) == BOND)
    // The test runner's own address cannot receive ETH, so this withdrawal
    // fails in the transfer: the credit and the balance must be untouched.
    assert!(
        failed_with<TransferFailed>(attempt(arbiter, ArbiterMsg::Withdraw {})),
    )
    assert!(credit(arbiter, account: evm.address()) == BOND)
    assert!(evm.balance(arbiter) == BOND)
}

#[test(balance = 10_000_000)]
fn withdrawing_pays_the_credit_once() uses (evm: mut Evm) {
    let arbiter = deploy(window: seconds(0))
    let wallet = evm.create2<Wallet>(value: Wei::zero(), args: (), salt: 1)
    let vectors = honest()
    let id: u256 = evm
        .call(
            addr: wallet,
            gas: GAS,
            value: BOND,
            message: WalletMsg::Post {
                arbiter,
                x0: vectors.x0,
                hidden1: vectors.hidden1,
                hidden2: vectors.hidden2,
                hidden3: vectors.hidden3,
                hidden4: vectors.hidden4,
                logits: vectors.logits,
                class: vectors.class,
            },
        )
    assert!(finalize(arbiter, id).success())
    assert!(credit(arbiter, account: wallet) == BOND)
    assert!(evm.balance(wallet) == Wei::zero())

    let paid: Wei = evm
        .call(
            addr: wallet,
            gas: GAS,
            value: Wei::zero(),
            message: WalletMsg::Collect { arbiter },
        )
    assert!(paid == BOND)
    assert!(evm.balance(wallet) == BOND)
    assert!(evm.balance(arbiter) == Wei::zero())
    assert!(credit(arbiter, account: wallet) == Wei::zero())
    assert!(
        !attempt(arbiter: wallet, WalletMsg::Collect { arbiter }).success(),
    )
    assert!(evm.balance(wallet) == BOND)
}

/// What the test wallet does: post a claim with the ETH it is sent, collect
/// its credits.
msg WalletMsg {
    #[selector = sol(
        "post(address,uint256[9],uint256[141],uint256[35],uint256[9],uint256[1],int32[3],uint8)",
    )]
    Post {
        arbiter: Address,
        x0: [u256; 9],
        hidden1: [u256; 141],
        hidden2: [u256; 35],
        hidden3: [u256; 9],
        hidden4: [u256; 1],
        logits: [i32; 3],
        class: u8,
    } -> u256,
    #[selector = sol("collect(address)")]
    Collect { arbiter: Address } -> Wei,
}

/// A claimant that can receive ETH, which the test runner's address cannot.
contract Wallet uses (ctx: Ctx, call: mut Call) {
    recv {
        #[payable]
        WalletMsg::Post { arbiter, x0, hidden1, hidden2, hidden3, hidden4, logits, class } -> u256
        uses (ctx, mut call)
        {
            call.call(
                addr: arbiter,
                gas: GAS,
                value: ctx.value(),
                message: ArbiterMsg::Claim {
                    x0,
                    hidden1,
                    hidden2,
                    hidden3,
                    hidden4,
                    logits,
                    class,
                },
            )
        }

        WalletMsg::Collect { arbiter } -> Wei uses (mut call) {
            call.call(
                addr: arbiter,
                gas: GAS,
                value: Wei::zero(),
                message: ArbiterMsg::Withdraw {},
            )
        }

        /// Plain ETH transfers (the arbiter's `withdraw`) are accepted.
        #[payable]
        _ {}
    }
}

#[test(balance = 10_000_000)]
fn finalising_before_the_deadline_is_too_early() uses (evm: mut Evm) {
    let arbiter = deploy(window: LONG)
    let id = post(arbiter, honest())
    assert!(failed_with<TooEarly>(finalize(arbiter, id)))
    assert!(
        failed_with<NotFinal>(attempt(arbiter, ArbiterMsg::ResultOf { id })),
    )
    assert!(
        failed_with<NothingToWithdraw>(attempt(arbiter, ArbiterMsg::Withdraw {})),
    )
    assert!(status(arbiter, id) == OPEN)
}
