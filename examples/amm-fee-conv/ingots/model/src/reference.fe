/// The logits of sample 3.
pub const LOGITS3: Logits = Accumulators::from_raw([57, 1247, -1819])
/// The class of sample 3.
pub const CLASS3: usize = 1

#[test]
fn sample_3_matches_the_reference() {
    assert!(layer1::apply(x: X3) == HIDDEN1_3)
    assert!(layer2::apply(x: HIDDEN1_3) == HIDDEN2_3)
    assert!(layer3::apply(x: HIDDEN2_3) == HIDDEN3_3)
    assert!(layer4::apply(x: HIDDEN3_3) == HIDDEN4_3)
    assert!(layer5::apply(x: HIDDEN4_3) == LOGITS3)
    assert!(classify(x: X3) == CLASS3)
}

#[test]
fn sample_3_matches_neuron_by_neuron() {
    let words1 = X3.words()
    for p in 0 .. 281 {
        let first = layer1::span_first(p)
        var span: [u256; 2] = [0; 2]
        for i in 0 .. 2 {
            span[i] = words1[first + i]
        }
        for j in 0 .. 16 {
            let expected = HIDDEN1_3.get(p * 16 + j)
            let row = layer1::row(j).words()
            let bias = layer1::bias(j).raw()
            assert!(
                layer1::output_from_words(row, x: words1, position: p, bias) == expected,
            )
            assert!(
                layer1::output_from_span(row, x: span, first, position: p, bias) == expected,
            )
        }
    }
    let words2 = HIDDEN1_3.words()
    for p in 0 .. 70 {
        let first = layer2::span_first(p)
        var span: [u256; 3] = [0; 3]
        for i in 0 .. 3 {
            span[i] = words2[first + i]
        }
        for j in 0 .. 16 {
            let expected = HIDDEN2_3.get(p * 16 + j)
            let row = layer2::row(j).words()
            let bias = layer2::bias(j).raw()
            assert!(
                layer2::output_from_words(row, x: words2, position: p, bias) == expected,
            )
            assert!(
                layer2::output_from_span(row, x: span, first, position: p, bias) == expected,
            )
        }
    }
    let words3 = HIDDEN2_3.words()
    for p in 0 .. 17 {
        let first = layer3::span_first(p)
        var span: [u256; 3] = [0; 3]
        for i in 0 .. 3 {
            span[i] = words3[first + i]
        }
        for j in 0 .. 16 {
            let expected = HIDDEN3_3.get(p * 16 + j)
            let row = layer3::row(j).words()
            let bias = layer3::bias(j).raw()
            assert!(
                layer3::output_from_words(row, x: words3, position: p, bias) == expected,
            )
            assert!(
                layer3::output_from_span(row, x: span, first, position: p, bias) == expected,
            )
        }
    }
    for j in 0 .. 32 {
        let got = layer4::neuron_from_words(
            row: layer4::row(j).words(),
            x: HIDDEN3_3.words(),
            bias: layer4::bias(j).raw(),
        )
        assert!(got == HIDDEN4_3.get(j))
    }
    for j in 0 .. 3 {
        let got = layer5::neuron_from_words(
            row: layer5::row(j).words(),
            x: HIDDEN4_3.words(),
            bias: layer5::bias(j).raw(),
        )
        assert!(got == LOGITS3.at(j).raw())
    }
}
