/// The logits of sample 2.
pub const LOGITS2: Logits = Accumulators::from_raw([412, 1157, -2196])
/// The class of sample 2.
pub const CLASS2: usize = 1

#[test]
fn sample_2_matches_the_reference() {
    assert!(layer1::apply(x: X2) == HIDDEN1_2)
    assert!(layer2::apply(x: HIDDEN1_2) == HIDDEN2_2)
    assert!(layer3::apply(x: HIDDEN2_2) == HIDDEN3_2)
    assert!(layer4::apply(x: HIDDEN3_2) == HIDDEN4_2)
    assert!(layer5::apply(x: HIDDEN4_2) == LOGITS2)
    assert!(classify(x: X2) == CLASS2)
}

#[test]
fn sample_2_matches_neuron_by_neuron() {
    let words1 = X2.words()
    for p in 0 .. 281 {
        let first = layer1::span_first(p)
        var span: [u256; 2] = [0; 2]
        for i in 0 .. 2 {
            span[i] = words1[first + i]
        }
        for j in 0 .. 16 {
            let expected = HIDDEN1_2.get(p * 16 + j)
            let row = layer1::row(j).words()
            let bias = layer1::bias(j).raw()
            assert!(
                layer1::output_from_words(row, x: words1, position: p, bias) == expected,
            )
            assert!(
                layer1::output_from_span(row, x: span, first, position: p, bias) == expected,
            )
        }
    }
    let words2 = HIDDEN1_2.words()
    for p in 0 .. 70 {
        let first = layer2::span_first(p)
        var span: [u256; 3] = [0; 3]
        for i in 0 .. 3 {
            span[i] = words2[first + i]
        }
        for j in 0 .. 16 {
            let expected = HIDDEN2_2.get(p * 16 + j)
            let row = layer2::row(j).words()
            let bias = layer2::bias(j).raw()
            assert!(
                layer2::output_from_words(row, x: words2, position: p, bias) == expected,
            )
            assert!(
                layer2::output_from_span(row, x: span, first, position: p, bias) == expected,
            )
        }
    }
    let words3 = HIDDEN2_2.words()
    for p in 0 .. 17 {
        let first = layer3::span_first(p)
        var span: [u256; 3] = [0; 3]
        for i in 0 .. 3 {
            span[i] = words3[first + i]
        }
        for j in 0 .. 16 {
            let expected = HIDDEN3_2.get(p * 16 + j)
            let row = layer3::row(j).words()
            let bias = layer3::bias(j).raw()
            assert!(
                layer3::output_from_words(row, x: words3, position: p, bias) == expected,
            )
            assert!(
                layer3::output_from_span(row, x: span, first, position: p, bias) == expected,
            )
        }
    }
    for j in 0 .. 32 {
        let got = layer4::neuron_from_words(
            row: layer4::row(j).words(),
            x: HIDDEN3_2.words(),
            bias: layer4::bias(j).raw(),
        )
        assert!(got == HIDDEN4_2.get(j))
    }
    for j in 0 .. 3 {
        let got = layer5::neuron_from_words(
            row: layer5::row(j).words(),
            x: HIDDEN4_2.words(),
            bias: layer5::bias(j).raw(),
        )
        assert!(got == LOGITS2.at(j).raw())
    }
}

