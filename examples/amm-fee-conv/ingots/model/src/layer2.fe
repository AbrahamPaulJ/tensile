// The compiler packs `INT8` itself and requires the packed literal above.
static_assert(FILTERS.weights().is_packed_from(INT8))

/// Number of positions of the output.
pub const POSITIONS: usize = 70

/// Number of filters, the channels of the output.
pub const FILTER_COUNT: usize = 16

/// Number of consecutive input words that `output_from_span` takes: enough to hold any window.
pub const SPAN_WORDS: usize = 3

/// Layer 2: accumulators with 14 fractional bits, requantised by 7 bits and clamped to 0..127,
/// position by position.
pub fn apply(x: Activations<4496, 6>) -> Activations<1120, 7> {
    let acc: Accumulators<1120, 14> = conv1d(
        filters: FILTERS,
        x: Sequence::from_flat(x),
        bias: BIAS,
    )
    acc.requantise<7>()
}

/// Output value `position * 16 + j` of this layer alone: filter `j` (row `j` and bias `j`) on the
/// window of `position`. It is `tensile::filter_at`, `neuron` on `window`, the two functions
/// `apply` runs for every position and filter.
pub fn output(row: Row<64, 8>, x: Activations<4496, 6>, position: usize, bias: Q<14>) -> i8 {
    assert!(position < POSITIONS)
    filter_at(row, x, start: position * 64, bias).shifted<7>().clamped()
}

/// `output` on packed words, the whole input. Fails if the row or the input is malformed.
pub fn output_from_words(row: [u256; 2], x: [u256; 141], position: usize, bias: i32) -> i8 {
    output(
        row: Row::from_words(row),
        x: Activations::from_words(x),
        position,
        bias: Q::from_raw(bias),
    )
}

/// The first of the `SPAN_WORDS` input words that hold the window of `position`.
pub fn span_first(_ position: usize) -> usize {
    let first = position * 64 / 32
    if first > 138 { 138 } else { first }
}

/// `output` from only `SPAN_WORDS` words of the input, the ones that start at word `first`: the
/// window of `position` is cut from them. Equal to `output_from_words` on the whole input
/// whenever `x` are its words `first ..` and the window lies inside them; fails otherwise, or if
/// the row or a value is malformed.
pub fn output_from_span(
    row: [u256; 2],
    x: [u256; 3],
    first: usize,
    position: usize,
    bias: i32,
) -> i8 {
    assert!(position < POSITIONS)
    let filter: Row<64, 8> = Row::from_words(row)
    let words: Activations<96, 6> = Activations::from_words(x)
    let acc: Q<14> = filter_at(
        row: filter,
        x: words,
        start: position * 64 - first * 32,
        bias: Q::from_raw(bias),
    )
    acc.shifted<7>().clamped()
}

/// Filter `j`.
pub const fn row(_ j: usize) -> Row<64, 8> {
    FILTERS.row(j)
}

/// Bias `j`.
pub const fn bias(_ j: usize) -> Q<14> {
    BIAS.at(j)
}
