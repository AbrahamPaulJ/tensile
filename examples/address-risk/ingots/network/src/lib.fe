/// Runs the network on an input given as packed words (`docs/spec.md`
/// section 7). A malformed input reverts.
pub msg NetworkMsg {
    /// The predicted class, 0..1.
    #[selector = sol("classify(uint256[1])")]
    Classify { x: [u256; 1] } -> u256,
    /// Every hidden vector as packed words, in layer order, and the logits.
    #[selector = sol("trace(uint256[1])")]
    Trace { x: [u256; 1] } -> ([u256; 1], [u256; 1], [i32; 2]),
}

/// The network 14 -> 32 -> 16 -> 2 on the EVM.
pub contract Network uses (call: Call) {
    rows0: Address,

    init(holder0: Address) uses (mut rows0) { rows0 = holder0 }

    recv NetworkMsg {
        Classify { x } -> u256 uses (call, rows0) {
            let (_, _, logits) = forward(x: Activations::from_words(x), rows0)
            logits.argmax() as u256
        }

        Trace { x } -> ([u256; 1], [u256; 1], [i32; 2])
        uses (call, rows0)
        {
            let (hidden1, hidden2, logits) = forward(x: Activations::from_words(x), rows0)
            (hidden1.words(), hidden2.words(), logits.values())
        }
    }
}

/// The forward pass: every hidden vector and the logits. One function for both handlers, so
/// that the weights of the later layers are in the contract's code once.
fn forward(x: Input, rows0: Address) -> (Activations<32, 6>, Activations<16, 6>, Logits)
uses (call: Call)
{
    let hidden1 = first_layer(x, rows0)
    let hidden2 = layer2::apply(x: hidden1)
    let logits = layer3::apply(x: hidden2)
    (hidden1, hidden2, logits)
}

/// Layer 1, one neuron at a time: `layer1::neuron` on a row and bias fetched from
/// the weight contract that holds them.
fn first_layer(x: Input, rows0: Address) -> Activations<32, 6>
uses (call: Call)
{
    var values: [i8; 32] = [0; 32]
    for j in 0 .. 32 {
        let holder = {
            rows0
        }
        let (row, bias) = holder.static(RowMsg::Row { j })
        values[j] = layer1::neuron(row: Row::from_words(row), x, bias: Q::from_raw(bias))
    }
    Activations::pack(values)
}
