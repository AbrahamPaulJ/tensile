//! Tests of `RiskGate` against the generated arbiter of this workspace.
//! Reference sample 0 is an account the model clears (class 0), sample 6 one
//! it flags (class 1). The test runner is the operator; `Visitor` stands for
//! any other account.
use arbiter::{Arbiter, ArbiterMsg}
use ingot::{CLEARED, FLAGGED, GateMsg, NotCleared, NotOperator, RiskGate, UNSCORED, WrongInput}
use model::{commitment, reference}
use std::evm::{Address, Call, Duration, Evm, Wei, is_error, seconds, wei}

const GAS: u256 = 16777216
const BOND: Wei = wei(1_000_000)

msg VisitorMsg {
    #[selector = sol("enter(address)")]
    Enter { gate: Address } -> u256,
    #[selector = sol("score(address,address,uint256,uint256[1])")]
    Score { gate: Address, account: Address, id: u256, x0: [u256; 1] } -> u8,
}

/// An account other than the operator: it forwards `enter` and `score`.
contract Visitor uses (call: mut Call) {
    recv {
        VisitorMsg::Enter { gate } -> u256 uses (mut call) {
            call.call(
                addr: gate,
                gas: GAS,
                value: Wei::zero(),
                message: GateMsg::Enter {},
            )
        }

        VisitorMsg::Score { gate, account, id, x0 } -> u8
        uses (mut call)
        {
            call.call(
                addr: gate,
                gas: GAS,
                value: Wei::zero(),
                message: GateMsg::Score { account, id, x0 },
            )
        }
    }
}

/// An arbiter with the given window, a gate reading it with the test runner
/// as operator, and a visitor.
fn setup(window: Duration) -> (Address, Address, Address) uses (evm: mut Evm) {
    let arbiter = evm
        .create2<Arbiter>(
            value: Wei::zero(),
            args: (commitment::MODEL_ROOT, BOND, window),
            salt: 0,
        )
    let gate = evm.create2<RiskGate>(
            value: Wei::zero(),
            args: (arbiter, evm.address()),
            salt: 0,
        )
    let visitor = evm.create2<Visitor>(value: Wei::zero(), args: (), salt: 0)
    (arbiter, gate, visitor)
}

/// Posts the honest claim about reference sample 0 (class 0).
fn claim_clear(_ court: Address) -> u256 uses (evm: mut Evm) {
    evm.call(
        addr: court,
        gas: GAS,
        value: BOND,
        message: ArbiterMsg::Claim {
            x0: reference::X0.words(),
            hidden1: reference::HIDDEN1_0.words(),
            hidden2: reference::HIDDEN2_0.words(),
            logits: reference::LOGITS0.values(),
            class: reference::CLASS0.downcast_truncate(),
        },
    )
}

/// Posts the honest claim about reference sample 6 (class 1).
fn claim_flagged(_ court: Address) -> u256 uses (evm: mut Evm) {
    evm.call(
        addr: court,
        gas: GAS,
        value: BOND,
        message: ArbiterMsg::Claim {
            x0: reference::X6.words(),
            hidden1: reference::HIDDEN1_6.words(),
            hidden2: reference::HIDDEN2_6.words(),
            logits: reference::LOGITS6.values(),
            class: reference::CLASS6.downcast_truncate(),
        },
    )
}

fn finalize(_ court: Address, id: u256) uses (evm: mut Evm) {
    evm.call(
        addr: court,
        gas: GAS,
        value: Wei::zero(),
        message: ArbiterMsg::Finalize { id },
    )
}

fn standing(gate: Address, account: Address) -> u8 uses (evm: mut Evm) {
    evm.call(
        addr: gate,
        gas: GAS,
        value: Wei::zero(),
        message: GateMsg::StandingOf { account },
    )
}

fn entries(gate: Address) -> u256 uses (evm: mut Evm) {
    evm.call(
        addr: gate,
        gas: GAS,
        value: Wei::zero(),
        message: GateMsg::Entries {},
    )
}

#[test]
fn the_reference_samples_are_one_clear_and_one_flagged() {
    assert!(reference::CLASS0 == 0)
    assert!(reference::CLASS6 == 1)
}

#[test(balance = 10_000_000)]
fn a_cleared_account_enters() uses (evm: mut Evm) {
    // A window of zero: the claim can be finalised at once.
    let (arbiter, gate, visitor) = setup(window: seconds(0))
    let id = claim_clear(arbiter)
    finalize(arbiter, id)
    let class: u8 = evm
        .call(
            addr: gate,
            gas: GAS,
            value: Wei::zero(),
            message: GateMsg::Score { account: visitor, id, x0: reference::X0.words() },
        )
    assert!(class == 0)
    assert!(standing(gate, account: visitor) == CLEARED)
    let features: u256 = evm
        .call(
            addr: gate,
            gas: GAS,
            value: Wei::zero(),
            message: GateMsg::FeaturesOf { account: visitor },
        )
    assert!(features == reference::X0.words()[0])
    let count: u256 = evm
        .call(
            addr: visitor,
            gas: GAS,
            value: Wei::zero(),
            message: VisitorMsg::Enter { gate },
        )
    assert!(count == 1)
    assert!(entries(gate) == 1)
}

#[test(balance = 10_000_000)]
fn a_flagged_account_is_refused() uses (evm: mut Evm) {
    let (arbiter, gate, visitor) = setup(window: seconds(0))
    let id = claim_flagged(arbiter)
    finalize(arbiter, id)
    let class: u8 = evm
        .call(
            addr: gate,
            gas: GAS,
            value: Wei::zero(),
            message: GateMsg::Score { account: visitor, id, x0: reference::X6.words() },
        )
    assert!(class == 1)
    assert!(standing(gate, account: visitor) == FLAGGED)
    let outcome = evm
        .try_call(
            addr: visitor,
            gas: GAS,
            value: Wei::zero(),
            message: VisitorMsg::Enter { gate },
        )
    assert!(!outcome.success())
    assert!(entries(gate) == 0)
}

#[test(balance = 10_000_000)]
fn an_unscored_account_is_refused_with_its_own_error() uses (evm: mut Evm) {
    // The test runner itself was never scored.
    let (_, gate, _) = setup(window: seconds(0))
    let outcome = evm.try_call(
            addr: gate,
            gas: GAS,
            value: Wei::zero(),
            message: GateMsg::Enter {},
        )
    assert!(
        !outcome.success() && is_error<NotCleared>(outcome.returndata()),
    )
    assert!(standing(gate, account: evm.address()) == UNSCORED)
}

#[test(balance = 10_000_000)]
fn an_open_claim_sets_no_standing() uses (evm: mut Evm) {
    let (arbiter, gate, visitor) = setup(window: seconds(1_000_000))
    let id = claim_clear(arbiter)
    let outcome = evm
        .try_call(
            addr: gate,
            gas: GAS,
            value: Wei::zero(),
            message: GateMsg::Score { account: visitor, id, x0: reference::X0.words() },
        )
    assert!(!outcome.success())
    assert!(standing(gate, account: visitor) == UNSCORED)
}

#[test(balance = 10_000_000)]
fn a_claim_about_other_features_is_refused() uses (evm: mut Evm) {
    // The final claim is about sample 0 and clears it. Presenting it for the
    // features of sample 6, which the model flags, must not clear anyone.
    let (arbiter, gate, visitor) = setup(window: seconds(0))
    let id = claim_clear(arbiter)
    finalize(arbiter, id)
    let outcome = evm
        .try_call(
            addr: gate,
            gas: GAS,
            value: Wei::zero(),
            message: GateMsg::Score { account: visitor, id, x0: reference::X6.words() },
        )
    assert!(
        !outcome.success() && is_error<WrongInput>(outcome.returndata()),
    )
    assert!(standing(gate, account: visitor) == UNSCORED)
}

#[test(balance = 10_000_000)]
fn only_the_operator_scores() uses (evm: mut Evm) {
    let (arbiter, gate, visitor) = setup(window: seconds(0))
    let id = claim_clear(arbiter)
    finalize(arbiter, id)
    let outcome = evm
        .try_call(
            addr: visitor,
            gas: GAS,
            value: Wei::zero(),
            message: VisitorMsg::Score { gate, account: visitor, id, x0: reference::X0.words() },
        )
    assert!(!outcome.success())
    assert!(standing(gate, account: visitor) == UNSCORED)
    // Called directly by a non-operator, the error is the gate's own. The
    // gate below names the visitor as operator, so the test runner is not.
    let other = evm.create2<RiskGate>(value: Wei::zero(), args: (arbiter, visitor), salt: 1)
    let direct = evm
        .try_call(
            addr: other,
            gas: GAS,
            value: Wei::zero(),
            message: GateMsg::Score { account: visitor, id, x0: reference::X0.words() },
        )
    assert!(
        !direct.success() && is_error<NotOperator>(direct.returndata()),
    )
}
